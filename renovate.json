{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "pillow"
      ],
      "allowedVersions": "<12.0.0"
    },
    {
      "description": "pymupdf and pymupdf4llm are released in lockstep — update them together",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["pymupdf", "pymupdf4llm"],
      "groupName": "pymupdf"
    },
    {
      "description": "Pin each Nextcloud matrix entry to its own major version",
      "matchDepNames": ["nextcloud-33"],
      "allowedVersions": "/^33\\./"
    },
    {
      "matchDepNames": ["nextcloud-34"],
      "allowedVersions": "/^34\\./"
    },
    {
      "description": "Pin docker-compose.yml Nextcloud image to 33.x",
      "matchPackageNames": ["docker.io/library/nextcloud"],
      "matchFileNames": ["docker-compose.yml"],
      "allowedVersions": "/^33\\./"
    },
    {
      "description": "Cap Python at 3.14 until psycopg-binary ships cp315 wheels — 3.15 broke bump-version",
      "matchPackageNames": ["python", "actions/python-versions", "docker.io/library/python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "pdf.js in the open_document viewer (cdnjs <script> pins); both tags bump together",
      "matchManagers": ["html"],
      "matchDepNames": ["pdf.js"],
      "groupName": "pdf.js",
      "prBodyNotes": [
        "The viewer serves pdf.js inline from `nextcloud_mcp_server/server/vendor/pdfjs/`, and cdnjs publishes no SRI hashes for pdf.js 4+, so this PR's `integrity` attributes are stale. Run `uv run python scripts/sync_pdfjs.py --repin` on this branch and commit the result; until then `test_served_viewer_loads_no_external_script` fails."
      ]
    }
  ],
  "html": {
    "enabled": true,
    "managerFilePatterns": ["/^nextcloud_mcp_server/server/document_viewer\\.html$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Nextcloud version matrix pins in CI — each entry gets a version-specific dep name",
      "managerFilePatterns": [
        "/^\\.github/workflows/test\\.yml$/"
      ],
      "matchStrings": [
        "nextcloud_version:\\s*\"(?<major>\\d+)\"\\s*\\n\\s*#?\\s*nextcloud_image:\\s*\"(?<packageName>[^:]+):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "depNameTemplate": "nextcloud-{{{major}}}",
      "packageNameTemplate": "docker.io/library/nextcloud",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Unified pact CLI version + installer SHA256 pinned in .github/scripts/install-pact-cli.sh — github-release-attachments bumps the digest alongside the version",
      "managerFilePatterns": [
        "/^\\.github/scripts/install-pact-cli\\.sh$/"
      ],
      "matchStrings": [
        "#\\s?renovate: datasource=github-release-attachments depName=(?<depName>\\S+)\\n[A-Z_]+VERSION=\"(?<currentValue>[^\"]+)\"\\n[A-Z_]+SHA256=\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
